#!/usr/bin/env bash

resolve_workspace_repo() {
  local path=$1

  case "$path" in
    "$HOME"/Documents/geolytix.nosync/worktrees/*/*)
      if [[ -e $path/.git ]]; then
        printf '%s\n' "$path"
        return
      fi
      ;;
  esac

  printf '%s\n' "$path"
}

workspace_name_for_path() {
  local path=$1 rel repo name rest

  # worktrees/<repo>/<name>[/<repo>] -> <name>
  rel=${path#"$HOME/Documents/geolytix.nosync/worktrees/"}
  if [[ $rel != "$path" ]]; then
    IFS=/ read -r repo name rest <<< "$rel"
    if [[ -n $name ]]; then
      printf '%s\n' "$name"
      return
    fi
  fi

  printf '%s\n' "${path##*/}"
}

fzf_theme_scheme() {
  local colors_file="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
  local mode

  if [[ -r $colors_file ]]; then
    mode=$(awk -F= '/^[[:space:]]*mode[[:space:]]*=/ {
      gsub(/[[:space:]"]/, "", $2)
      print $2
      exit
    }' "$colors_file")
  fi

  case "$mode" in
    light) printf '%s\n' light ;;
    *) printf '%s\n' dark ;;
  esac
}

list_worktrees() {
  local root="$HOME/Documents/geolytix.nosync/worktrees" dir inner

  [[ -d $root ]] || return 0

  # Layouts:
  #   worktrees/<repo>/<branch>          (herdr / manual)
  #   worktrees/<repo>/<name>/<repo>     (Zed)
  for dir in "$root"/*/*/; do
    dir=${dir%/}
    [[ -d $dir ]] || continue

    if [[ -e $dir/.git ]]; then
      printf '%s\n' "$dir"
      continue
    fi

    for inner in "$dir"/*/; do
      inner=${inner%/}
      [[ -e $inner/.git ]] && printf '%s\n' "$inner"
    done
  done
}

list_projects() {
  local root

  for root in \
    "$HOME/Documents/geolytix.nosync" \
    "$HOME/Documents/rob" \
    "$HOME/.config"
  do
    [[ -d $root ]] || continue
    find "$root" -mindepth 1 -maxdepth 1 -type d
  done
}

mode=all
if [[ ${1:-} == --worktrees ]]; then
  mode=worktrees
  shift
fi

if [[ $# -eq 1 ]]; then
  selected_input=$1
else
  selected_input=$( {
    if [[ $mode == all ]]; then
      list_projects
    fi
    list_worktrees
  } | fzf --color="$(fzf_theme_scheme)" )
fi

if [[ -z $selected_input ]]; then
  exit 0
fi

selected=$(resolve_workspace_repo "$selected_input")
selected_name=$(workspace_name_for_path "$selected_input" | tr . _)

# HERDR_BIN_PATH can retain the kernel's " (deleted)" suffix when Herdr is
# upgraded while its server is still running. Fall back to the current binary.
herdr_bin=${HERDR_BIN_PATH:-}
if [[ ! -x $herdr_bin ]]; then
  herdr_bin=$(command -v herdr) || {
    printf 'herdr-sessionizer: herdr is not installed or not in PATH\n' >&2
    exit 127
  }
fi

workspace_id=$("$herdr_bin" workspace list | jq -r --arg label "$selected_name" \
  'first(.result.workspaces[] | select(.label == $label) | .workspace_id) // empty')

if [[ -n $workspace_id ]]; then
  "$herdr_bin" workspace focus "$workspace_id"
else
  "$herdr_bin" workspace create --cwd "$selected" --label "$selected_name" --focus
fi
